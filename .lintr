linters: linters_with_defaults(
    # Line length is relaxed from the 80 character default to accommodate
    # SQL strings and long argument lists common in this package.
    line_length_linter = line_length_linter(120L),
    # The package uses camelCase names alongside snake_case.
    object_name_linter = object_name_linter(styles = c("snake_case", "camelCase", "symbols")),
    # object_usage_linter produces false positives with tidy-evaluation (NSE).
    object_usage_linter = NULL,
    # Explicit return() statements are an accepted style in this package.
    return_linter = NULL,
    # The package uses the magrittr pipe throughout.
    pipe_consistency_linter = pipe_consistency_linter(pipe = "%>%")
  )
encoding: "UTF-8"
exclusions: list(
    # Vendored / generated / documentation directories.
    "^renv/",
    "^packrat/",
    "^docs/",
    "^Meta/",
    "^lib/",
    "^extras/",
    "^inst/shiny/",
    "^tests/testthat/fixtures/"
  )
